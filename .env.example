# Bodhan.AI credentials — one key per model. Copy to `.env` and fill in.
# NEVER put real keys in this file: it is a template and is committed.
# Keys are redacted from repr()/logs by the settings model.

BODHAN_OCR_KEY=
BODHAN_TRANSLATE_KEY=
BODHAN_SPEAK_KEY=
BODHAN_TRANSCRIBE_KEY=

# Base URL of the Bodhan gateway (all four models).
BODHAN_API_BASE_URL=https://api.bodhan.ai

# General LLM for structure / quality / composition only (not a Bodhan model).
# LLM_API_KEY=           # falls back to GEMINI_API_KEY from the process env
# LLM_MODEL=gemini-3.6-flash

# --- Paths (relative to project root) ---
# DATA_DIR=data
